pipeline {
  agent {
    docker {
      image 'eithiriphyo/maven-docker-agent:v1'
      args '-u 1000:1000 -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  environment {
    SONAR_URL = "http://54.160.99.121:9000"
    DOCKER_IMAGE = "eithiriphyo/ultimate-cicd:${BUILD_NUMBER}"
  }

  stages {

    stage('Cleanup Workspace') {
      steps {
        cleanWs()
      }
    }

    stage('Checkout') {
      steps {
        git branch: 'main',
        url: 'https://github.com/eithiriphyo/Jenkin-CICD-Pipeline.git'
      }
    }

    stage('Build & Test') {
      steps {
        sh '''
          cd spring-boot-app
          mvn clean package -DskipTests
        '''
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh '''
            cd spring-boot-app
            mvn sonar:sonar \
              -Dsonar.host.url=$SONAR_URL \
              -Dsonar.token=$SONAR_AUTH_TOKEN
          '''
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        sh '''
          cd spring-boot-app
          docker build -t $DOCKER_IMAGE .
        '''
      }
    }

    stage('Push Docker Image') {
      steps {
        script {
          docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
            docker.image(DOCKER_IMAGE).push()
          }
        }
      }
    }

    stage('Update Deployment') {
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config user.email "you@example.com"
            git config user.name "jenkins"

            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" spring-boot-app-manifests/deployment.yml

            git add .
            git commit -m "Update image tag ${BUILD_NUMBER}" || true
            git push https://${GITHUB_TOKEN}@github.com/eithiriphyo/Jenkin-CICD-Pipeline.git HEAD:main
          '''
        }
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
